# Copy this file to .env and set the default event label.
# Restart the nametag service after changing this value:
#   sudo systemctl restart nametag
#
# Available values:
#   Guild42.ch
#   CH-Open.ch
#   Workshop-Tage.ch

DEFAULT_SUBTITLE=Guild42.ch

# --- Optional REST API (see README, section "REST API") ---
# Only active when api_tokens.txt exists. These values are optional.
#API_TOKENS_FILE=/etc/nametag/api_tokens.txt
#API_RATE_LIMIT=10/minute
#API_RATE_LIMIT_GLOBAL=30/minute
